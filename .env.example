# NICHEPULSE Configuration

# API Keys (Sécurité : ne jamais exposer côté frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base de données (Défaut : SQLite local, ou PostgreSQL + pgvector)
# DATABASE_URL=postgresql://user:password@localhost:5432/nichepulse
DATABASE_URL=sqlite:///./nichepulse.db

# Mode par défaut (DEMO ou REAL)
DEFAULT_DATA_MODE=DEMO

# Paramètres API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
